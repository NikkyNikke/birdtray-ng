#!/bin/sh
set -eu

STATE_DIR="@HOME@/.local/share/birdtray-wayland"
export XDG_CONFIG_HOME="$STATE_DIR/config"
export XDG_CONFIG_DIRS="$STATE_DIR/xdg-config"
export XDG_DATA_HOME="$STATE_DIR/data"
export XDG_CACHE_HOME="$STATE_DIR/cache"
export TMPDIR="$STATE_DIR/tmp"

exec @HOME@/.local/opt/birdtray-wayland/birdtray "$@"
